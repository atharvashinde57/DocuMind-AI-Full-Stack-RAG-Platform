# ==================================================
# DocuMind AI Environment Configuration Template
# ==================================================

# Optional: OpenAI API Key for GPT-4o-mini & OpenAI Embeddings
# If left blank, DocuMind AI automatically runs in Local Grounded Fallback Mode!
OPENAI_API_KEY=

# Optional: Custom OpenAI compatible endpoint (Groq, OpenRouter, LocalAI, vLLM)
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Sentence Transformer model for local vector embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Database configuration for Docker Compose
POSTGRES_DB=documind_db
POSTGRES_USER=documind_user
POSTGRES_PASSWORD=documind_password

# Gateway & Service URLs
AI_SERVICE_URL=http://localhost:8000
JWT_SECRET=9a4f2c8d7e6b5a4f3e2d1c0b9a8f7e6d5c4b3a2f1e0d9c8b7a6f5e4d3c2b1a0
